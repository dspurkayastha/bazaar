# Postgres 16 from docker-compose.yml, bound to 127.0.0.1:${BAZAAR_PG_PORT:-5433}
# BAZAAR_PG_PORT=5433   (set by deploy/setup-vps.sh to a free port)
DATABASE_URL=postgres://bazaar:bazaar@localhost:5433/bazaar

# Claude API key for the agent loop
ANTHROPIC_API_KEY=

# Household-level READ token: GET /ledger/summary only. /request, /approve and /places need a member's own
# token (mtk_...), issued by `pnpm db:seed` (printed once) or `pnpm member:token <memberId>` (rotates).
BAZAAR_API_TOKEN=

# HMAC-SHA256 key shared with the WhatsApp relay: it signs each raw webhook body as
# x-bazaar-signature: sha256=<hex>. Unset = /webhooks/whatsapp refuses everything (503).
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WHATSAPP_WEBHOOK_SECRET=

# 32-byte key, base64, for encrypting supplier OAuth tokens at rest
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Optional: model for the agent loop (default claude-sonnet-5-5; claude-sonnet-4-5 is deprecated, EOL 30 Nov 2026)
ANTHROPIC_MODEL=

# API server (defaults: 127.0.0.1:8787). With DATABASE_URL set, BAZAAR_HOUSEHOLD_ID is required.
PORT=8787
HOST=127.0.0.1
BAZAAR_HOUSEHOLD_ID=
# "stub" (in-memory supplier, default) or "registry" (src/suppliers/registry.ts exporting createSuppliers())
BAZAAR_SUPPLIERS=stub

# ---- Voice (/voice WebSocket, docs/VOICE_PROTOCOL.md; Sarvam STT + TTS) ----
# Unset = /voice answers `error` voice_unconfigured and closes. Try it first: pnpm voice:test / voice:say / voice:chat
SARVAM_API_KEY=
# STT (saaras:v4 streaming): transcribe | translate | verbatim | translit | codemix (default codemix)
SARVAM_STT_MODE=codemix
# bn-IN, hi-IN, en-IN, ... or "unknown" to auto-detect (default unknown; Sarvam then returns language_probability)
SARVAM_STT_LANGUAGE=unknown
# TTS: bulbul:v2 | bulbul:v3 | bulbul:v4-flash (default bulbul:v3). The streaming socket only outputs MP3.
SARVAM_TTS_MODEL=bulbul:v3
# TTS voice per reply language (default shubh). If Sarvam rejects one, the log line sarvam_tts_speaker_rejected names the var.
SARVAM_SPEAKER_BN=shubh
SARVAM_SPEAKER_HI=shubh
SARVAM_SPEAKER_EN=shubh

# ---- Web app (docs/WEB_API.md): served by Bazaar at /, passkey sign-in, PIN approvals ----
# The web app's origin and the passkey relying-party id. Passkeys only work on this exact origin.
# Local dev: WEB_ORIGIN=http://localhost:8787 and WEBAUTHN_RP_ID=localhost (the defaults when unset).
WEB_ORIGIN=https://bazaar.sciscribesolutions.com
WEBAUTHN_RP_ID=bazaar.sciscribesolutions.com
# Approving a held cart above this total (whole rupees) needs the owner's PIN on every channel (web PIN pad,
# phone keypad, POST /approve). At or under it an owner's spoken or tapped yes is enough. Default 500.
PIN_REQUIRED_ABOVE_RUPEES=500
# Built web app served at / (pnpm web:build writes web/dist). Default web/dist.
# WEB_DIST=web/dist
