# Postgres 16 from docker-compose.yml (host port 5433)
DATABASE_URL=postgres://bazaar:bazaar@localhost:5433/bazaar

# Claude API key for the agent loop
ANTHROPIC_API_KEY=

# Single bearer token for the v1 HTTP API
BAZAAR_API_TOKEN=

# 32-byte key, base64, for encrypting supplier OAuth tokens at rest
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Optional: model for the agent loop (default claude-sonnet-4-5)
ANTHROPIC_MODEL=

# API server (defaults: 127.0.0.1:8787). With DATABASE_URL set, BAZAAR_HOUSEHOLD_ID is required.
PORT=8787
HOST=127.0.0.1
BAZAAR_HOUSEHOLD_ID=
# "stub" (in-memory supplier, default) or "registry" (src/suppliers/registry.ts exporting createSuppliers())
BAZAAR_SUPPLIERS=stub
