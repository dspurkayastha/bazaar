# Postgres 16 from docker-compose.yml (host port 5433)
DATABASE_URL=postgres://bazaar:bazaar@localhost:5433/bazaar

# Claude API key for the agent loop
ANTHROPIC_API_KEY=

# Single bearer token for the v1 HTTP API
BAZAAR_API_TOKEN=

# 32-byte key, base64, for encrypting supplier OAuth tokens at rest
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
